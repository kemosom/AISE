# Supabase student submission backend
# Safe to expose to the browser. Security is enforced by Supabase RLS.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-your-supabase-publishable-key
# Legacy projects may use this instead:
# VITE_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key

# Instructor Admin
# Choose your own private access code in Vercel.
INSTRUCTOR_ADMIN_CODE=replace-with-your-private-code

# AES-256 key used to decrypt the instructor-only answer payload.
# Do not expose this value through VITE_* variables.
INSTRUCTOR_CONTENT_KEY=replace-with-the-private-base64url-key
